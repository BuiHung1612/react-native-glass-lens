{
  "name": "react-native-glass-lens",
  "version": "0.1.1",
  "description": "Liquid-glass for React Native: GPU blur, edge refraction and magnifying lenses over your own views. Fabric, Android + iOS, no private APIs.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "android",
    "ios",
    "*.podspec",
    "react-native.config.js",
    "LICENSE",
    "README.md",
    "!android/build",
    "!android/.gradle",
    "!**/.DS_Store"
  ],
  "keywords": [
    "react-native",
    "react-native-component",
    "fabric",
    "new-architecture",
    "glass",
    "liquid-glass",
    "glassmorphism",
    "blur",
    "backdrop",
    "lens",
    "magnifier",
    "refraction",
    "tab-bar",
    "android",
    "ios",
    "metal",
    "agsl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuiHung1612/react-native-glass-lens.git"
  },
  "homepage": "https://github.com/BuiHung1612/react-native-glass-lens#readme",
  "bugs": {
    "url": "https://github.com/BuiHung1612/react-native-glass-lens/issues"
  },
  "author": "BuiHung1612",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.80.0"
  },
  "codegenConfig": {
    "name": "RNGlassLensSpec",
    "type": "components",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.glasslens"
    },
    "ios": {
      "componentProvider": {
        "RNGlassTargetView": "RNGlassTargetView",
        "RNGlassBackdropView": "RNGlassBackdropView"
      }
    }
  }
}
